{
  "info": {
    "name": "Inventory AI System API",
    "description": "Full API collection for Inventory AI / SmartBill backend.\n\n**Base:** `{{baseUrl}}` = http://localhost:8000/api/v1\n**Swagger:** http://localhost:8000/docs\n\n### Quick start\n1. Ensure backend is running on port 8000.\n2. Run **Auth → Login** (seed: admin@blulabs.in / Admin@12345).\n3. Token is saved to `{{token}}` automatically.\n4. Create resources; IDs are saved to collection variables.\n\nSee also: docs/API_COLLECTION.md",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_postman_id": "inventory-ai-system-full-v2"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8000/api/v1" },
    { "key": "host", "value": "http://localhost:8000" },
    { "key": "token", "value": "" },
    { "key": "refreshToken", "value": "" },
    { "key": "itemId", "value": "" },
    { "key": "itemCode", "value": "ITM-SAMSUNG-S25U" },
    { "key": "brandId", "value": "" },
    { "key": "categoryId", "value": "" },
    { "key": "partyId", "value": "" },
    { "key": "templateId", "value": "" },
    { "key": "invoiceId", "value": "" },
    { "key": "recordingId", "value": "" },
    { "key": "draftId", "value": "" },
    { "key": "userId", "value": "" },
    { "key": "gstin", "value": "29ABCDE1234F1Z5" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "item": [
    {
      "name": "System",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": "{{host}}/health",
            "description": "No auth. Returns app/DB health."
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const j = pm.response.json();",
                  "  pm.collectionVariables.set('token', j.access_token);",
                  "  if (j.refresh_token) pm.collectionVariables.set('refreshToken', j.refresh_token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"owner.demo@blulabs.in\",\n  \"password\": \"Owner@12345\",\n  \"business_name\": \"Demo Store\",\n  \"owner_name\": \"Demo Owner\",\n  \"mobile\": \"9876543210\",\n  \"gst_number\": \"29ABCDE1234F1Z5\",\n  \"address\": \"Bengaluru, Karnataka\"\n}"
            },
            "url": "{{baseUrl}}/auth/register",
            "description": "Creates owner + company. Do not assign admin via public register."
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const j = pm.response.json();",
                  "  pm.collectionVariables.set('token', j.access_token);",
                  "  if (j.refresh_token) pm.collectionVariables.set('refreshToken', j.refresh_token);",
                  "  console.log('Token saved');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@blulabs.in\",\n  \"password\": \"Admin@12345\"\n}"
            },
            "url": "{{baseUrl}}/auth/login",
            "description": "Local seed admin. Saves access + refresh tokens."
          }
        },
        {
          "name": "Refresh Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const j = pm.response.json();",
                  "  pm.collectionVariables.set('token', j.access_token);",
                  "  if (j.refresh_token) pm.collectionVariables.set('refreshToken', j.refresh_token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{refreshToken}}\"\n}"
            },
            "url": "{{baseUrl}}/auth/refresh"
          }
        },
        {
          "name": "Me (current user)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/auth/me"
          }
        }
      ]
    },
