APP_NAME=Inventory AI System API
APP_ENV=development
APP_DEBUG=true
SECRET_KEY=change-me-in-production
JWT_SECRET_KEY=change-me-in-production
JWT_REFRESH_SECRET_KEY=change-me-refresh-secret
ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_EXPIRE_DAYS=7
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/inventory_ai
OPENAI_API_KEY=
CORS_ORIGINS=http://localhost:3000
OPENAI_TRANSCRIPTION_MODEL=whisper-1
OPENAI_TRANSCRIPTION_FALLBACK_MODEL=whisper-1
OPENAI_EXTRACTION_MODEL=gpt-4.1-mini
OPENAI_TIMEOUT_SECONDS=60
OPENAI_MAX_RETRIES=5
OPENAI_RATE_LIMIT_RETRIES=2
VOICE_MAX_UPLOAD_MB=25
# Optional dev fallback when OpenAI speech API is rate-limited (requires APP_DEBUG=true):
# VOICE_FALLBACK_TRANSCRIPT=Create invoice for Raj Electronics, 2 Samsung Galaxy S25 Ultra.
ELEVENLABS_API_KEY=
ELEVENLABS_STT_MODEL=scribe_v2
VOICE_UPLOAD_RATE_LIMIT_PER_MINUTE=20
